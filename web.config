<?xml version="1.0" encoding="UTF-8"?>
<!--
  Defensive IIS config for the APPLICATION ROOT.

  The correct setup on Plesk/Windows is to point the site Document Root at the
  "public" subfolder (see public/web.config). This file is only a safety net in
  case the Document Root is accidentally set to the repository root: it blocks
  direct web access to secrets, source code, the database migrations, and
  uploaded files so they cannot be downloaded over HTTP.
-->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <!-- Block source/config/data folders if this directory is ever web-exposed. -->
        <hiddenSegments>
          <add segment="app" />
          <add segment="config" />
          <add segment="database" />
          <add segment="storage" />
          <add segment="resources" />
          <add segment="scripts" />
          <add segment="views" />
        </hiddenSegments>
        <!-- Block sensitive files by extension/name. -->
        <fileExtensions>
          <add fileExtension=".env" allowed="false" />
          <add fileExtension=".sql" allowed="false" />
          <add fileExtension=".md" allowed="false" />
        </fileExtensions>
        <denyUrlSequences>
          <add sequence=".env" />
        </denyUrlSequences>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
