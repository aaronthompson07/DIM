APP_ENV=production



APP_DEBUG=false



APP_NAME=DoItMeow
# Optional: if set, overrides the VERSION file in the repo root (normally leave unset).
# APP_VERSION=



APP_URL=http://localhost







DB_HOST=127.0.0.1



DB_PORT=3306



DB_DATABASE=doitmeow



DB_USERNAME=root



DB_PASSWORD=







SESSION_NAME=doitmeow_session



SESSION_TTL=86400



# Optional: set to e.g. .doitmeow.com (leading dot) so the session cookie is sent to other

# subdomains (ArrowChat integration.php reading doitmeow_session). Requires HTTPS in production.

SESSION_COOKIE_DOMAIN=







# Set to false to hide public /register company signup



ALLOW_PUBLIC_SIGNUP=true







# Google AdSense (optional): pub id ca-pub-xxxxxxxx and display ad unit id



GOOGLE_ADSENSE_CLIENT=



GOOGLE_ADSENSE_SLOT_DASHBOARD=







# ArrowChat: autoload script in the page footer when the plan has “ArrowChat” enabled



# in Admin → feature matrix. Override URL if needed (default: doitmeow.com …/autoload.php).



ARROWCHAT_AUTOLOAD_URL=



# Optional: signed cookie so ArrowChat on another subdomain can read the DoItMeow user id

# (see app/Core/ArrowChatBridge.php). Requires HTTPS. Secret must match ArrowChat integration.php.

ARROWCHAT_BRIDGE_ENABLED=false

ARROWCHAT_BRIDGE_SECRET=

ARROWCHAT_BRIDGE_COOKIE_DOMAIN=.doitmeow.com

ARROWCHAT_BRIDGE_COOKIE_NAME=doitmeow_ac







# Google Analytics 4 (optional), e.g. G-XXXXXXXXXX



GA4_MEASUREMENT_ID=



